@@ -0,0 +1,174 @@
+/**
+ * @license
+ * Copyright 2026 Google Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {randomUUID} from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const GRACE_MS = 2000;
+const TIMEOUT_MS = 8000;
+const RETRY_MS = 25;
+const wait = new Int32Array(new SharedArrayBuffer(4));
+const ownerPattern = /^owner-[0-9a-f-]{36}$/;
+
+function hasCode(error: unknown, codes: string[]): boolean {
+  return (
+    error instanceof Error &&
+    'code' in error &&
+    codes.includes(String(error.code))
+  );
+}
+
+// undefined is absent; an empty string is a guard whose marker was removed.
+function readOwner(lockPath: string): string | undefined {
+  try {
+    if (!fs.lstatSync(lockPath).isDirectory()) {
+      throw new Error('Expected a directory');
+    }
+    const entries = fs.readdirSync(lockPath);
+    if (entries.length === 0) {
+      return '';
+    }
+    const marker = entries[0]!;
+    if (entries.length !== 1 || !ownerPattern.test(marker)) {
+      throw new Error('Unrecognized owner marker');
+    }
+    const ownerPath = path.join(lockPath, marker);
+    if (!fs.lstatSync(ownerPath).isFile()) {
+      throw new Error('Expected a regular owner marker');
+    }
+    const owner = JSON.parse(fs.readFileSync(ownerPath, 'utf8'));
+    if (owner?.version !== 1 || marker !== `owner-${owner.token}`) {
+      throw new Error('Unrecognized owner record');
+    }
+    return marker;
+  } catch (error) {
+    if (hasCode(error, ['ENOENT'])) {
+      return undefined;
+    }
+    throw new Error(`Cannot read metadata lock ${lockPath}`, {cause: error});
+  }
+}
+
+function removeOwner(lockPath: string, marker: string): void {
+  if (marker) {
+    try {
+      fs.unlinkSync(path.join(lockPath, marker));
+    } catch (error) {
+      if (hasCode(error, ['ENOENT'])) {
+        // This pathname may already belong to a successor. Do not remove it.
+        return;
+      }
+      throw error;
+    }
+  }
+  try {
+    fs.rmdirSync(lockPath);
+  } catch (error) {
+    if (hasCode(error, ['ENOENT'])) {
+      return;
+    }
+    if (hasCode(error, ['ENOTEMPTY', 'EEXIST', 'EPERM', 'EACCES'])) {
+      const successor = readOwner(lockPath);
+      if (
+        successor ||
+        (successor === undefined && hasCode(error, ['ENOTEMPTY', 'EEXIST']))
+      ) {
+        return;
+      }
+    }
+    throw error;
+  }
+}
+
+function acquire(lockPath: string, prepared: string): void {
+  const deadline = performance.now() + TIMEOUT_MS;
+  let observedOwner: string | undefined;
+  let observedAt = 0;
+  for (;;) {
+    if (performance.now() >= deadline) {
+      throw new Error(`Timed out waiting for metadata lock ${lockPath}`);
+    }
+    let owner = readOwner(lockPath);
+    if (owner === undefined) {
+      observedOwner = undefined;
+      try {
+        fs.renameSync(prepared, lockPath);
+        return;
+      } catch (error) {
+        if (!hasCode(error, ['ENOTEMPTY', 'EEXIST', 'EPERM', 'EACCES'])) {
+          throw error;
+        }
+        owner = readOwner(lockPath);
+        // A competing writer can release between the failed rename and inspection.
+        // ENOTEMPTY/EEXIST prove contention; permission errors need a recognized guard.
+        if (owner === undefined && !hasCode(error, ['ENOTEMPTY', 'EEXIST'])) {
+          throw error;
+        }
+      }
+    }
+    const now = performance.now();
+    if (owner === undefined) {
+      observedOwner = undefined;
+    } else {
+      if (owner !== observedOwner) {
+        observedOwner = owner;
+        observedAt = now;
+      }
+      if (now - observedAt >= GRACE_MS) {
+        removeOwner(lockPath, owner);
+        observedOwner = undefined;
+        continue;
+      }
+    }
+    const remaining = deadline - now;
+    if (remaining <= 0) {
+      throw new Error(`Timed out waiting for metadata lock ${lockPath}`);
+    }
+    Atomics.wait(wait, 0, 0, Math.min(RETRY_MS, remaining));
+  }
+}
+
+/**
+ * Serializes short synchronous metadata updates by cooperating writers.
+ * Recovery uses a continuously observed owner's grace period, not proof of death.
+ * An old writer paused beyond the grace period can still publish after recovery.
+ * @internal
+ */
+export function withMetadataLock<T>(
+  browserRoot: string,
+  task: () => T,
+  log?: (message: string) => void,
+): T {
+  fs.mkdirSync(browserRoot, {recursive: true});
+  const lockPath = path.join(browserRoot, '.metadata.lock');
+  const token = randomUUID();
+  const marker = `owner-${token}`;
+  const prepared = path.join(browserRoot, `.metadata.lock-prepared-${token}`);
+  fs.mkdirSync(prepared);
+  let acquired = false;
+  try {
+    fs.writeFileSync(
+      path.join(prepared, marker),
+      JSON.stringify({version: 1, token}),
+      {flag: 'wx'},
+    );
+    acquire(lockPath, prepared);
+    acquired = true;
+    return task();
+  } finally {
+    try {
+      if (acquired) {
+        removeOwner(lockPath, marker);
+      } else {
+        // Only this unpublished private candidate may be recursively removed.
+        fs.rmSync(prepared, {recursive: true, force: true});
+      }
+    } catch (error) {
+      log?.(`Failed to clean up metadata lock ${lockPath}: ${String(error)}`);
+    }
+  }
+}
