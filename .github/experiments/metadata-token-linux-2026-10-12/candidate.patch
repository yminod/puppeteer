+ * Copyright 2026 Google Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {Browser} from '../../../lib/browser-data/browser-data.js';
+import {Cache} from '../../../lib/Cache.js';
+
+const [root, mode, label] = process.argv.slice(2);
+if (!root || !mode || !label) {
+  throw new Error('Expected cache root, mode and label');
+}
+const cache = new Cache(root);
+process.once('message', async () => {
+  if (mode === 'hold') {
+    const read = cache.readMetadata.bind(cache);
+    cache.readMetadata = browser => {
+      const metadata = read(browser);
+      process.send?.('holding');
+      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0);
+      return metadata;
+    };
+  }
+  for (let index = 0; index < (mode === 'hold' ? 1 : 100); index++) {
+    cache.writeAlias(Browser.CHROME, `${label}-${index}`, String(index));
+    await new Promise<void>(resolve => {
+      setImmediate(resolve);
+    });
+  }
+  process.disconnect();
+});
+process.send?.('ready');
