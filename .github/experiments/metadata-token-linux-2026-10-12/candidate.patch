+  const children: Array<{child: ChildProcess; closed: Promise<void>}> = [];
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), 'puppeteer-metadata-lock-'));
+    lockPath = path.join(root, '.metadata.lock');
+    sandbox = sinon.createSandbox();
+  });
+
+  afterEach(async () => {
+    sandbox.restore();
+    for (const {child, closed} of children.splice(0)) {
+      if (child.exitCode === null && child.signalCode === null) {
+        child.kill('SIGKILL');
+      }
+      await closed;
+    }
+    fs.rmSync(root, {recursive: true, force: true});
+  });
+
+  function owner(version = 1): string {
+    const token = randomUUID();
+    fs.mkdirSync(lockPath);
+    const marker = `owner-${token}`;
+    fs.writeFileSync(
+      path.join(lockPath, marker),
+      JSON.stringify({version, token}),
+    );
+    return marker;
+  }
+
+  function clock(onWait?: (now: number) => void): () => number {
+    let now = 0;
+    sandbox.stub(performance, 'now').callsFake(() => {
+      return now;
+    });
+    sandbox
+      .stub(Atomics, 'wait')
+      .callsFake((_array, _index, _value, duration) => {
+        now += Number(duration);
+        onWait?.(now);
+        return 'timed-out';
+      });
+    return () => {
+      return now;
+    };
+  }
+
+  it('publishes a complete owner record before entering the task', () => {
+    const renameSync = fs.renameSync;
+    sandbox.stub(fs, 'renameSync').callsFake((from, to) => {
+      assert.equal(String(to), lockPath);
+      const entries = fs.readdirSync(from);
+      assert.equal(entries.length, 1);
+      const record = JSON.parse(
+        fs.readFileSync(path.join(String(from), entries[0]!), 'utf8'),
+      );
+      assert.equal(record.version, 1);
+      assert.equal(entries[0], `owner-${record.token}`);
+      renameSync(from, to);
+    });
+    const result = {};
+    assert.equal(
+      withMetadataLock(root, () => {
+        assert.equal(fs.readdirSync(lockPath).length, 1);
+        return result;
+      }),
+      result,
+    );
+    assert.deepEqual(fs.readdirSync(root), []);
+  });
+
+  for (const empty of [false, true]) {
+    it(`recovers an unchanged ${empty ? 'empty' : 'token'} guard after the grace period`, () => {
+      if (empty) {
+        fs.mkdirSync(lockPath);
+      } else {
+        owner();
+      }
+      const now = clock();
+      let entered = false;
+      withMetadataLock(root, () => {
+        entered = true;
+        assert.ok(now() >= 2000);
+      });
+      assert.ok(entered);
+      assert.equal(now(), 2000);
+      assert.deepEqual(fs.readdirSync(root), []);
+    });
+  }
+
+  it('restarts the grace period when the observed owner changes', () => {
+    owner();
+    let changed = false;
+    const now = clock(time => {
+      if (!changed && time === 1000) {
+        fs.rmSync(lockPath, {recursive: true});
+        owner();
+        changed = true;
+      }
+    });
+    withMetadataLock(root, () => {
+      assert.ok(changed);
+      assert.equal(now(), 3000);
+    });
+  });
+
+  it('bounds total waiting despite continuously changing owners', () => {
+    owner();
+    clock(time => {
+      if (time % 1000 === 0) {
+        fs.rmSync(lockPath, {recursive: true});
+        owner();
+      }
+    });
+    const task = sandbox.spy();
+    assert.throws(() => {
+      withMetadataLock(root, task);
+    }, /Timed out waiting for metadata lock/);
+    assert.equal(task.callCount, 0);
+    assert.deepEqual(fs.readdirSync(root), ['.metadata.lock']);
+    assert.equal(fs.readdirSync(lockPath).length, 1);
+  });
+
+  for (const malformed of ['version', 'json', 'file', 'symlink', 'contents']) {
+    it(`preserves an unrecognized guard (${malformed}) and does not enter the task`, () => {
+      if (malformed === 'file') {
+        fs.writeFileSync(lockPath, 'not a directory');
+      } else if (malformed === 'symlink') {
+        const target = path.join(root, 'target');
+        fs.mkdirSync(target);
+        fs.symlinkSync(target, lockPath, 'junction');
+      } else {
+        const marker = owner(malformed === 'version' ? 2 : 1);
+        if (malformed === 'json') {
+          fs.writeFileSync(path.join(lockPath, marker), '{');
+        } else if (malformed === 'contents') {
+          fs.writeFileSync(path.join(lockPath, 'unexpected'), 'keep');
+        }
+      }
+      const before = fs.lstatSync(lockPath);
+      const task = sandbox.spy();
+      const removal = sandbox.spy(fs, 'unlinkSync');
+      assert.throws(() => {
+        withMetadataLock(root, task);
+      }, /Cannot read metadata lock/);
+      assert.equal(task.callCount, 0);
+      assert.equal(removal.callCount, 0);
+      assert.equal(fs.lstatSync(lockPath).ino, before.ino);
+      assert.ok(
+        !fs.readdirSync(root).some(name => {
+          return name.startsWith('.metadata.lock-prepared-');
+        }),
+      );
+    });
+  }
+
+  it('retries a contention rename error when the competing guard has already disappeared', () => {
+    const renameSync = fs.renameSync;
+    const rename = sandbox.stub(fs, 'renameSync').callsFake((from, to) => {
+      if (rename.callCount === 1) {
+        const marker = owner();
+        fs.unlinkSync(path.join(lockPath, marker));
+        fs.rmdirSync(lockPath);
+        throw Object.assign(new Error('destination occupied during rename'), {
+          code: 'ENOTEMPTY',
+        });
+      }
+      renameSync(from, to);
+    });
+    clock();
+    const task = sandbox.spy();
+    withMetadataLock(root, task);
+    assert.equal(task.callCount, 1);
+    assert.equal(rename.callCount, 2);
+    assert.deepEqual(fs.readdirSync(root), []);
+  });
+
+  it('does not turn an unconfirmed permission error into contention', () => {
+    const failure = Object.assign(new Error('permission denied'), {
+      code: 'EACCES',
+    });
+    sandbox.stub(fs, 'renameSync').throws(failure);
+    const task = sandbox.spy();
+    assert.throws(
+      () => {
+        withMetadataLock(root, task);
+      },
+      error => {
+        return error === failure;
+      },
+    );
+    assert.equal(task.callCount, 0);
+    assert.deepEqual(fs.readdirSync(root), []);
+  });
+
+  it('leaves the successor guard untouched when an old owner finally releases', () => {
+    let next: string;
+    let inode: number;
+    const result = {};
+    assert.equal(
+      withMetadataLock(root, () => {
+        fs.rmSync(lockPath, {recursive: true});
+        next = owner();
+        inode = fs.statSync(lockPath).ino;
+        return result;
+      }),
+      result,
+    );
+    assert.deepEqual(fs.readdirSync(lockPath), [next!]);
+    assert.equal(fs.statSync(lockPath).ino, inode!);
+  });
+
+  it('does not remove a successor published between marker unlink and directory removal', () => {
+    const rmdirSync = fs.rmdirSync;
+    let next: string;
+    let inode: number;
+    sandbox.stub(fs, 'rmdirSync').callsFake(target => {
+      assert.equal(String(target), lockPath);
+      rmdirSync(lockPath);
+      next = owner();
+      inode = fs.statSync(lockPath).ino;
+      rmdirSync(target);
+    });
+    withMetadataLock(root, () => {});
+    assert.deepEqual(fs.readdirSync(lockPath), [next!]);
+    assert.equal(fs.statSync(lockPath).ino, inode!);
+  });
+
+  it('does not let a stale reaper delete a successor after another reaper removed the old marker', () => {
+    const old = owner();
+    const unlinkSync = fs.unlinkSync;
+    let next: string;
+    let time = 0;
+    sandbox.stub(performance, 'now').callsFake(() => {
+      return time;
+    });
+    sandbox.stub(Atomics, 'wait').callsFake(() => {
+      time = 2000;
+      return 'timed-out';
+    });
+    sandbox.stub(fs, 'unlinkSync').callsFake(target => {
+      assert.equal(String(target), path.join(lockPath, old));
+      unlinkSync(target);
+      fs.rmdirSync(lockPath);
+      next = owner();
+      time = 8000;
+      unlinkSync(target);
+    });
+    assert.throws(() => {
+      withMetadataLock(root, () => {
+        assert.fail('must not enter');
+      });
+    }, /Timed out waiting/);
+    assert.deepEqual(fs.readdirSync(lockPath), [next!]);
+    assert.deepEqual(fs.readdirSync(root), ['.metadata.lock']);
+  });
+
+  it('removes a failed private preparation without replacing the primary error', () => {
+    const marker = owner();
+    const failure = new Error('owner write failed');
+    sandbox.stub(fs, 'writeFileSync').throws(failure);
+    assert.throws(
+      () => {
+        withMetadataLock(root, () => {});
+      },
+      error => {
+        return error === failure;
+      },
+    );
+    assert.deepEqual(fs.readdirSync(lockPath), [marker]);
+    assert.deepEqual(fs.readdirSync(root), ['.metadata.lock']);
+  });
+
+  function worker(cacheRoot: string, mode: string, label: string) {
+    const child = fork(
+      fileURLToPath(new URL('./fixtures/metadataWriter.js', import.meta.url)),
+      [cacheRoot, mode, label],
+      {stdio: ['ignore', 'ignore', 'inherit', 'ipc']},
+    );
+    const messages: unknown[] = [];
+    child.on('message', message => {
+      messages.push(message);
+    });
+    let error: Error | undefined;
+    child.on('error', failure => {
+      error = failure;
+    });
+    const closed = new Promise<void>(resolve => {
+      child.once('close', () => {
+        resolve();
+      });
+    });
+    children.push({child, closed});
+    return {
+      child,
+      closed,
+      messages,
+      async event(name: string) {
+        const deadline = Date.now() + 5000;
+        while (!messages.includes(name)) {
+          assert.ok(!error, String(error));
+          assert.ok(
+            child.exitCode === null && child.signalCode === null,
+            'worker exited',
+          );
+          assert.ok(Date.now() < deadline, `worker missing ${name}`);
+          await new Promise(resolve => {
+            setTimeout(resolve, 5);
+          });
+        }
+      },
+    };
+  }
+
+  it('preserves distinct aliases from two real concurrent Cache writers', async () => {
+    const cache = new Cache(root);
+    cache.writeAlias(Browser.CHROME, 'base', '0');
+    const writers = [worker(root, 'write', 'a'), worker(root, 'write', 'b')];
+    await Promise.all(
+      writers.map(child => {
+        return child.event('ready');
+      }),
+    );
+    for (const writer of writers) {
+      writer.child.send('start');
+    }
+    await Promise.all(
+      writers.map(child => {
+        return child.closed;
+      }),
+    );
+    for (const writer of writers) {
+      assert.equal(writer.child.exitCode, 0);
+    }
+    const metadata = cache.readMetadata(Browser.CHROME);
+    assert.equal(Object.keys(metadata.aliases).length, 201);
+    for (const label of ['a', 'b']) {
+      for (let index = 0; index < 100; index++) {
+        assert.equal(metadata.aliases[`${label}-${index}`], String(index));
+      }
+    }
+    assert.deepEqual(fs.readdirSync(cache.browserRoot(Browser.CHROME)), [
+      '.metadata',
+    ]);
+  });
+
+  it('recovers an interrupted writer directly from the install cache-hit path', async () => {
+    const cache = new Cache(root);
+    const buildId = '123';
+    const installationDir = cache.installationDir(
+      Browser.CHROME,
+      BrowserPlatform.LINUX,
+      buildId,
+    );
+    const executablePath = path.join(installationDir, 'custom', 'chrome');
+    fs.mkdirSync(path.dirname(executablePath), {recursive: true});
+    fs.writeFileSync(executablePath, '');
+    writeInstallMarker(installationDir, path.join('custom', 'chrome'));
+    cache.writeExecutablePath(
+      Browser.CHROME,
+      BrowserPlatform.LINUX,
+      buildId,
+      'stale',
+    );
+    cache.writeAlias(Browser.CHROME, 'base', '0');
+    const holder = worker(root, 'hold', 'interrupted');
+    await holder.event('ready');
+    holder.child.send('start');
+    await holder.event('holding');
+    const guard = path.join(
+      cache.browserRoot(Browser.CHROME),
+      '.metadata.lock',
+    );
+    assert.equal(fs.readdirSync(guard).length, 1);
+    holder.child.kill('SIGKILL');
+    await holder.closed;
+    assert.ok(fs.existsSync(guard));
+    const started = performance.now();
+    const result = await install({
+      cacheDir: root,
+      browser: Browser.CHROME,
+      platform: BrowserPlatform.LINUX,
+      buildId,
+    });
+    assert.ok(performance.now() - started >= 2000);
+    assert.equal(result.executablePath, executablePath);
+    assert.equal(
+      cache.readExecutablePath(Browser.CHROME, BrowserPlatform.LINUX, buildId),
+      path.join('custom', 'chrome'),
+    );
+    assert.equal(cache.resolveAlias(Browser.CHROME, 'base'), '0');
+    assert.ok(!fs.existsSync(guard));
+    assert.equal(fs.readFileSync(executablePath, 'utf8'), '');
+  });
+});
