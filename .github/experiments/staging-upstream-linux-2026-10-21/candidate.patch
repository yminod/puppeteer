+            assert.strictEqual(
+              (error as Error & {cause?: unknown}).cause,
+              linkError,
+            );
+            return true;
+          },
+        );
+        assert.strictEqual(fs.existsSync(archivePath), false);
+        assert.strictEqual(
+          fs.readFileSync(attempt.archivePath, 'utf8'),
+          'candidate',
+        );
+      } finally {
+        internalConstantsForTesting.link = originalLink;
+      }
+    });
+  }
