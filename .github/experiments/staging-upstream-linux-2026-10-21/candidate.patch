+    fs.mkdirSync(path.dirname(executablePath), {recursive: true});
+    fs.writeFileSync(executablePath, contents);
+    writeInstallMarker(outputPath, relativeExecutablePath);
+    return relativeExecutablePath;
+  }
+});
